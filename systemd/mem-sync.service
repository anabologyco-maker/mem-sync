[Unit]
Description=Shared Codex, Claude Code, and OpenCode project memory sync
Documentation=https://github.com/anabologyco-maker/mem-sync
After=local-fs.target

[Service]
Type=simple
ExecStart=/opt/mem-sync/bin/mem-sync daemon
# The daemon exits cleanly when its own source changes on disk, so pulling an
# update applies it on the next restart. That needs always, not on-failure.
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
